server {
  listen 8080;
  server_name _;
  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # Auth requests are small JSON documents.
  client_max_body_size 100k;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # The API, on the same origin as the pages: cookies stay first-party and
  # there is no CORS. Its responses carry the API's own security headers.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    # The original host, so the API's same-origin (CSRF) check compares
    # against the address the browser used.
    proxy_set_header Host $http_host;
    # Overwritten, never appended: a client cannot forge its own address.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
  }

  # Fingerprinted build output: the name changes whenever the content does.
  # A missing file is a 404, never the HTML page, so a stale tab fails
  # loudly and the application offers a reload.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # Every other path is a client-side route. The HTML is always revalidated
  # so a new release is picked up on the next visit.
  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
