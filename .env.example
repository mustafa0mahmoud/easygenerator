# Copy this file to `.env` and adjust if needed. `.env` is never committed.
# The defaults below work as-is for local development and Docker Compose.

# development | production | test
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Used when the API runs on the host (npm run start:dev).
# Docker Compose overrides it to reach the `mongo` service.
MONGODB_URI=mongodb://127.0.0.1:27017/easygenerator

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# true = human-readable logs (development only). false = JSON lines.
LOG_PRETTY=true

# Number of reverse proxies in front of the API (0 when exposed directly).
# Docker Compose sets 1 (nginx); the hosted setup uses 2 (see the README).
TRUST_PROXY_HOPS=0

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_SECONDS per IP.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Serve the OpenAPI UI at /api/docs.
SWAGGER_ENABLED=true

# --- Email ---
# console = print emails (and verification codes) to the server log. Local only:
#           the API refuses to start with it when NODE_ENV=production.
# brevo   = send real email through Brevo's HTTPS API (needs BREVO_API_KEY).
MAIL_DRIVER=console
MAIL_FROM_NAME=Auth Task
# With Brevo this must be a sender verified in your Brevo account.
MAIL_FROM_ADDRESS=no-reply@example.com
BREVO_API_KEY=

# --- Security ---
# Keys the hash of one-time codes. At least 32 characters.
# This example value is for local development only and is refused in production.
# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OTP_SECRET=dev-only-otp-secret-change-me-0000000000

# Signs access tokens. At least 32 characters. Same rule: example value is
# for local development only and is refused in production.
JWT_ACCESS_SECRET=dev-only-jwt-secret-change-me-0000000000

# Access token lifetime (60-3600). Short, because it cannot be revoked early.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime. Each one is single-use and replaced on refresh.
REFRESH_TOKEN_TTL_DAYS=7

# "Secure" attribute on session cookies. false only for local HTTP;
# the API refuses to start in production unless it is true.
COOKIE_SECURE=false

# Extra origins allowed to send state-changing requests (comma-separated).
# Leave empty when the browser reaches the API on the same origin as the app.
# The hosted setup lists the web app's origin here (see the README).
CSRF_TRUSTED_ORIGINS=

# scrypt cost for password hashing (log2 N). 17 = OWASP minimum, ~128 MiB per hash.
PASSWORD_HASH_LOG_N=17
